PORT=5000
CLIENT_URL=http://localhost:5173

# Database configuration (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mtm_agent_db?retryWrites=true&w=majority

# AI Provider Configuration
# Supported: gemini, openai, groq, ollama
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Operational Limits (as mandated by hackathon rules)
MAX_UPDATE_CALLS=5
FULL_RUN_TIMEOUT_MS=120000
UPDATE_TIMEOUT_MS=60000
DEFAULT_INPUT_FILE=input/messages.txt
